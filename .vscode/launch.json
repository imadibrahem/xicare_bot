{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: Current File /w arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}"
        },
        {
            "name": "awaken norbert",
            "type": "debugpy",
            "request": "launch",
            "program": "server/app.py",
            "console": "integratedTerminal",
            // "args": "${command:pickArgs}"
            "args": []
        },
        {
            "name": "correct ocr",
            "type": "debugpy",
            "request": "launch",
            "program": "data_processing/correct_ocr.py",
            "console": "integratedTerminal",
            "args": [
                "out/norbert-wiener-books/books/Cybernetics_shortened.md"
            ]
        },
        {
            "name": "create chat dataset",
            "type": "debugpy",
            "request": "launch",
            "program": "data_processing/create_chat_dataset.py",
            "console": "integratedTerminal",
            "args": [
                "out/norbert-wiener-books/articles/Interview_US_News_Machines_smarter_than_men.md",
                "out/dataset-1.json",
                "--user-prefix=Q:",
                "--model-prefix=A:",
                "--pairs-per-object=1"
            ]
        }
    ]
}