    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "generate embeddings",
            "type": "debugpy",
            "request": "launch",
            "program": "data_processing/generate_embeddings.py",
            "console": "integratedTerminal",
            // "args": "${command:pickArgs}"
            "args": [
                "--output=out/ex-prodigy.json",
                "--chunk-size=1024",
                "--chunk-overlap=200",
                // "--dimensionality=768",
                "--batch-size=20",
                "out/norbert-wiener-books/ex-prodigy-single.txt"
            ]
        },
        {
            "name": "awaken norbert",
            "type": "debugpy",
            "request": "launch",
            "program": "server/app.py",
            "console": "integratedTerminal",
            // "args": "${command:pickArgs}"
            "args": [
                // "--dimensionality=768",
                "out/ex-prodigy.json"
            ]
        }
    ]
}