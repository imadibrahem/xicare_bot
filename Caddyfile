{$SITE_ADDRESS} {
	encode
        
        # Global request size limit
	request_body {
		max_size 1MB
	}

        # pocketbase
	handle /_/* {
		reverse_proxy pocketbase:8080 {
			transport http {
				read_timeout 5s
				response_header_timeout 5s
			}
		}
	}

        handle /api/* {
		reverse_proxy pocketbase:8080 {
			transport http {
				read_timeout 5s
				response_header_timeout 5s
			}
		}
	}

	# API: restrict by IP
        @gen_api {
                path /v1/generation/*
                remote_ip {$IP_WHITELIST}
        }
        handle @gen_api {
                reverse_proxy generation:8000 {
                        transport http {
                                read_timeout 50s
                                response_header_timeout 50s
                        }
                }
        }
        handle /v1/generation/* {
                respond "Forbidden" 403
        }

        @telemetry_api {
                path /v1/telemetry
                remote_ip {$IP_WHITELIST}
        }
	handle @telemetry_api {
		reverse_proxy generation:8000 {
			transport http {
				read_timeout 5s
				response_header_timeout 5s
			}
		}
	}
        handle /v1/telemetry {
                respond "Forbidden" 403
        }



	# GUI generation
	handle /generation/* {
		reverse_proxy generation:8000 {
			transport http {
				read_timeout 50s
				response_header_timeout 50s
			}
		}
	}

	handle {
		root * /app/web-interface/build
		try_files {path} /index.html
		file_server
	}
}
