{$SITE_ADDRESS} {
	encode
	# pocketbase
	handle /_/* {
		reverse_proxy pocketbase:8080
	}

	handle /api/* {
		reverse_proxy pocketbase:8080
	}

	# API: restrict by IP
        @gen_api {
                path /v1/generation/*
                remote_ip {$IP_WHITELIST}
        }
        handle @gen_api {
                reverse_proxy generation:8000 {
                        transport http {
                                read_timeout 60s
                                response_header_timeout 60s
                        }
                }
        }
        handle /v1/generation/* {
                respond "Forbidden" 403
        }

        @telemetry_api {
                path /v1/telemetry
                remote_ip {$IP_WHITELIST}
        }
        handle @telemetry_api {
                reverse_proxy generation:8000
        }
        handle /v1/telemetry {
                respond "Forbidden" 403
        }



	# GUI generation
	handle /generation/* {
		reverse_proxy generation:8000
	}

	handle {
		root * /app/web-interface/build
		try_files {path} /index.html
		file_server
	}
}
